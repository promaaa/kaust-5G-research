    SDR -->|"5G NR access"| UE

    classDef ground fill:#172554,stroke:#3b82f6,color:#f8fafc,stroke-width:2px;
    classDef payload fill:#064e3b,stroke:#10b981,color:#f8fafc,stroke-width:2px;
    classDef user fill:#4c0519,stroke:#f43f5e,color:#f8fafc,stroke-width:2px;
    class Core,CU,Donor ground;
    class Modem,DU,SDR payload;
    class UE user;

