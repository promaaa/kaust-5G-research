flowchart LR
    subgraph Ground["Ground node"]
        Core["OAI 5G Core"]
        CU["OAI CU"]
        Donor["Donor gNB"]
        Core --- CU
        Core --- Donor
    end

    subgraph Payload["Airborne payload"]
        Modem["Quectel 5G modem"]
        DU["Embedded OAI DU"]
        SDR["Access SDR"]
        DU --> SDR
    end

    UE["Commercial 5G UE"]

    Donor -. "5G donor link" .-> Modem
